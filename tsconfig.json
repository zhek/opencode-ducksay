{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "solid-js/dist/solid.js": ["./node_modules/solid-js/types/index.d.ts"]
    },
    "types": ["bun"],
    "lib": ["ESNext"]
  },
  "include": ["src", "test", "index.ts"]
}